# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Editor / scratch files
tempCodeRunnerFile.py
.vscode/
.idea/

# Roadmaps (Internal planning)
*roadmap*.pdf
docs/*roadmap*.pdf

# Large / regenerable training data dumps
dataset/raw/
dataset/training/*.csv

# Allow small benchmark results, graphs, and models
!dataset/benchmarks/*.csv
!models/*.pkl
!graphs/*.png

# Office document binaries / generated reports
*.docx
*.doc
!docs/pbl2 FINAL REPORT.doc

